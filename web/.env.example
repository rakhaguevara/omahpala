# ——— Frontend (Vite membaca file .env / .env.local; hanya variabel VITE_* ikut ke browser) ———
# Find My Polo — Supabase. Isi dari Dashboard → Project Settings → API Keys.
# Pakai "publishable key" (sb_publishable_…) atau anon key lama. JANGAN pakai secret/service-role key di sini.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# ——— Perintah database (disalin ke web/.env.server; tidak pernah dibaca Vite) ———
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
