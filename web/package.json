{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "db:deploy": "node --env-file=.env.server node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file=.env.server node_modules/prisma/build/index.js migrate status",
    "db:sql": "node --env-file=.env.server node_modules/prisma/build/index.js db execute --file",
    "qr:generate": "node scripts/generate-qr-codes.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
